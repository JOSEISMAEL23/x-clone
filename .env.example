# PLANTILLA de variables de entorno — este archivo SÍ se sube a GitHub
# (a diferencia de .env.local), porque no tiene ningún valor real adentro:
# solo le muestra a cualquiera que clone el proyecto (o a ti mismo en el
# futuro) qué variables necesita crear para que la app funcione.
#
# Cómo usarlo: copia este archivo, renómbralo a ".env.local", y reemplaza
# los valores de ejemplo por tus credenciales reales de Supabase
# (Project Settings → API → Project URL / anon public key).
#
# Recuerda: en Vite, toda variable que el navegador deba poder leer tiene
# que empezar exactamente con el prefijo VITE_ — si la nombras distinto,
# import.meta.env no la va a encontrar.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
